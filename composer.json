{
    "name": "j4kim/darts",
    "description": "Fléchette championship from la tchaux",
    "type": "project",
    "require": {
        "bramus/router": "^1.6",
        "league/plates": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "J4kim\\Darts\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Joaquim Perez",
            "email": "jivkim@gmail.com"
        }
    ],
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:1234 -t public"
        ],
        "migrate": [
            "mysql --execute=\"drop database if exists darts\"",
            "mysql --execute=\"create database darts\"",
            "mysql darts < db/create_tables.sql",
            "mysql darts < db/seed.sql"
        ]
    }
}